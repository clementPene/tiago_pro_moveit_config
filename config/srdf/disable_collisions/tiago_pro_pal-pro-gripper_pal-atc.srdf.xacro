<?xml version="1.0" ?>
<robot name="tiago_pro" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find tiago_pro_moveit_config)/config/srdf/disable_collisions/tiago_pro_no-ee_no-ee.srdf.xacro" />
  <xacro:include filename="$(find tiago_pro_moveit_config)/config/srdf/disable_collisions/tiago_pro_pal-pro-gripper_no-arm-right.srdf.xacro" />
  <xacro:include filename="$(find tiago_pro_moveit_config)/config/srdf/disable_collisions/tiago_pro_no-arm-left_pal-atc.srdf.xacro" />
    <disable_collisions link1="arm_left_tool_link" link2="gripper_right_pal_atc_base_link" reason="Never"/>
    <disable_collisions link1="arm_left_tool_link" link2="gripper_right_tool_holder" reason="Never"/>
    <disable_collisions link1="arm_left_tool_link" link2="gripper_right_tool_mount" reason="Never"/>
    <disable_collisions link1="arm_right_tool_link" link2="gripper_left_base_link" reason="Never"/>
    <disable_collisions link1="arm_right_tool_link" link2="gripper_left_fingertip_left_link" reason="Never"/>
    <disable_collisions link1="arm_right_tool_link" link2="gripper_left_fingertip_right_link" reason="Never"/>
    <disable_collisions link1="arm_right_tool_link" link2="gripper_left_inner_finger_left_link" reason="Never"/>
    <disable_collisions link1="arm_right_tool_link" link2="gripper_left_inner_finger_right_link" reason="Never"/>
    <disable_collisions link1="arm_right_tool_link" link2="gripper_left_outer_finger_left_link" reason="Never"/>
    <disable_collisions link1="arm_right_tool_link" link2="gripper_left_outer_finger_right_link" reason="Never"/>
    <disable_collisions link1="arm_right_tool_link" link2="torso_arm_right_link" reason="Never"/>
</robot>
